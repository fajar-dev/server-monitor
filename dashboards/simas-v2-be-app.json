{
  "title": "simas-be | APP",
  "tags": ["simas-be", "logs", "app"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({job=\"simas-be-app\"}, level)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search (regex)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 1,
      "title": "Total Logs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\", level=~\"$level\"} |~ \"$search\" [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "2xx Success",
      "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=200 and status<300 [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "4xx Client Errors",
      "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=400 and status<500 [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "5xx Server Errors",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=500 [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "100 * sum(count_over_time({job=\"simas-be-app\"} | json | status>=500 [$__range])) / sum(count_over_time({job=\"simas-be-app\"} | json | status>=200 [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "p95 Latency",
      "type": "stat",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "quantile_over_time(0.95, {job=\"simas-be-app\"} | json | unwrap duration_ms [$__range]) without (level, detected_level, filename)", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 1000 } ] }
        },
        "overrides": []
      }
    },

    { "id": 101, "type": "row", "title": "Traffic & Errors", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "id": 10,
      "title": "Request Rate by Status Class",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=200 and status<300 [$__auto]))", "refId": "A", "legendFormat": "2xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=300 and status<400 [$__auto]))", "refId": "B", "legendFormat": "3xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=400 and status<500 [$__auto]))", "refId": "C", "legendFormat": "4xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=500 [$__auto]))", "refId": "D", "legendFormat": "5xx", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },
    {
      "id": 11,
      "title": "Log Volume by Level",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (level) (count_over_time({job=\"simas-be-app\", level=~\"$level\"} |~ \"$search\" [$__auto]))", "refId": "A", "legendFormat": "{{level}}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "info" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },

    { "id": 102, "type": "row", "title": "Latency", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },

    {
      "id": 20,
      "title": "Response Time Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 16, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "quantile_over_time(0.50, {job=\"simas-be-app\"} | json | unwrap duration_ms [$__auto]) without (level, detected_level, filename)", "refId": "A", "legendFormat": "p50", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "quantile_over_time(0.95, {job=\"simas-be-app\"} | json | unwrap duration_ms [$__auto]) without (level, detected_level, filename)", "refId": "B", "legendFormat": "p95", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "quantile_over_time(0.99, {job=\"simas-be-app\"} | json | unwrap duration_ms [$__auto]) without (level, detected_level, filename)", "refId": "C", "legendFormat": "p99", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },
    {
      "id": 21,
      "title": "Avg Latency",
      "type": "stat",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "avg_over_time({job=\"simas-be-app\"} | json | unwrap duration_ms [$__range]) without (level, detected_level, filename)", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "id": 22,
      "title": "Max Latency",
      "type": "stat",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "max_over_time({job=\"simas-be-app\"} | json | unwrap duration_ms [$__range]) without (level, detected_level, filename)", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0, "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 } ] }
        },
        "overrides": []
      }
    },

    { "id": 103, "type": "row", "title": "Breakdown", "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 } },

    {
      "id": 30,
      "title": "Top Endpoints (by requests)",
      "type": "table",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "topk(10, sum by (path) (count_over_time({job=\"simas-be-app\"} | json | path=~\".+\" [$__range])))", "refId": "A", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 31,
      "title": "Top Error Endpoints (5xx)",
      "type": "table",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "topk(10, sum by (path) (count_over_time({job=\"simas-be-app\"} | json | status>=500 | path=~\".+\" [$__range])))", "refId": "A", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 32,
      "title": "Status Distribution",
      "type": "piechart",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=200 and status<300 [$__range]))", "refId": "A", "instant": true, "legendFormat": "2xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=300 and status<400 [$__range]))", "refId": "B", "instant": true, "legendFormat": "3xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=400 and status<500 [$__range]))", "refId": "C", "instant": true, "legendFormat": "4xx", "datasource": { "type": "loki", "uid": "${datasource}" } },
        { "expr": "sum(count_over_time({job=\"simas-be-app\"} | json | status>=500 [$__range]))", "refId": "D", "instant": true, "legendFormat": "5xx", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": [ "value", "percent" ] } },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },

    { "id": 104, "type": "row", "title": "Logs", "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 } },

    {
      "id": 40,
      "title": "Live Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "{job=\"simas-be-app\", level=~\"$level\"} |~ \"$search\" | json", "refId": "A", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    }
  ]
}
