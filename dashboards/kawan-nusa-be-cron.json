{
  "title": "kawan-nusa-be - Cron Jobs",
  "tags": ["kawan-nusa-be", "cron", "loki", "jobs"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "task",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({job=\"kawan-nusa-be-cron\"}, task)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({job=\"kawan-nusa-be-cron\"}, level)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Search (regex)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 1,
      "title": "Total Cron Logs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=~\"$level\"} |~ \"$search\" [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "stat",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=\"error\"} [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Active Tasks",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "count(sum by (task) (count_over_time({job=\"kawan-nusa-be-cron\"} [$__range])))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Warnings",
      "type": "stat",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=\"warn\"} [$__range]))", "refId": "A", "instant": true, "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] }
    },

    { "id": 101, "type": "row", "title": "Activity", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "id": 10,
      "title": "Log Volume by Task",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (task) (count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=~\"$level\"} |~ \"$search\" [$__auto]))", "refId": "A", "legendFormat": "{{task}}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "sum" ] } }
    },
    {
      "id": 11,
      "title": "Errors by Task",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (task) (count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=\"error\"} [$__auto]))", "refId": "A", "legendFormat": "{{task}}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "sum" ] } }
    },

    { "id": 102, "type": "row", "title": "Breakdown", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },

    {
      "id": 20,
      "title": "Lines by Task & Level",
      "type": "table",
      "gridPos": { "x": 0, "y": 15, "w": 10, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (task, level) (count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=~\"$level\"} [$__range]))", "refId": "A", "instant": true, "format": "table", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 21,
      "title": "Log Distribution by Task",
      "type": "piechart",
      "gridPos": { "x": 10, "y": 15, "w": 6, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (task) (count_over_time({job=\"kawan-nusa-be-cron\", task=~\"$task\", level=~\"$level\"} [$__range]))", "refId": "A", "instant": true, "legendFormat": "{{task}}", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": [ "value", "percent" ] } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 22,
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "{job=\"kawan-nusa-be-cron\", task=~\"$task\", level=\"error\"} | json", "refId": "A", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    },

    { "id": 103, "type": "row", "title": "Logs", "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 } },

    {
      "id": 30,
      "title": "Live Cron Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        { "expr": "{job=\"kawan-nusa-be-cron\", task=~\"$task\", level=~\"$level\"} |~ \"$search\" | json", "refId": "A", "datasource": { "type": "loki", "uid": "${datasource}" } }
      ],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    }
  ]
}
