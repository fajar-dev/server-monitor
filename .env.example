# Copy to .env and fill in. Used by docker-compose.

# Loki Basic Auth proxy — Promtail clients on other servers must send these.
LOKI_USER=loki
LOKI_PASSWORD=change-me-to-a-strong-password

# Google Chat webhook for 5xx alerting (Grafana → Google Chat).
# Create a webhook in the target Google Chat space: Space → Apps & integrations
# → Webhooks → Add webhook, then paste the full URL here.
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...
